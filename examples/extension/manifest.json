{
  "manifest_version": 3,
  "name": "Cross-Entry Continuity (Reference)",
  "description": "Local, opt-in ChatGPT page preview and one-shot continuity demo. Not an official ChatGPT product.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1:8794/*",
    "http://localhost:8794/*"
  ],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Continuity preview", "default_popup": "popup.html"}
}
